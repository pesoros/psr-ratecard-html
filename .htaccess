Options -Indexes

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve the ratecard app at the domain root without changing the browser URL.
  # Excluding the target directory prevents rewrite loops.
  RewriteRule ^(?!apps/ratecard(?:/|$))(.*)$ apps/ratecard/$1 [L]
</IfModule>
