Options -Indexes

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # portfolio.pesoros.com -> apps/portfolio
  RewriteCond %{HTTP_HOST} ^(?:www\.)?portfolio\.pesoros\.com$ [NC]
  RewriteRule ^(?!apps/portfolio(?:/|$))(.*)$ apps/portfolio/$1 [L]

  # All other configured domains -> apps/ratecard
  RewriteCond %{HTTP_HOST} !^(?:www\.)?portfolio\.pesoros\.com$ [NC]
  RewriteRule ^(?!apps/ratecard(?:/|$))(.*)$ apps/ratecard/$1 [L]
</IfModule>
